# Copy this file to `.env.local` (never commit .env.local).

# Used ONLY by the dev/preview proxy in vite.config.js — never sent to the browser
# (no VITE_ prefix, so Vite does not put them in the app).
ZEVIO_API_URL=https://zevio-apis.vercel.app
ZEVIO_API_KEY=paste-the-api-key-here

# Where the admin panel lives: it is served at /<this value> instead of /admin,
# so it does not sit on the obvious URL. Any other path falls through to the
# customer app. Leave empty to keep /admin.
#   e.g. VITE_ADMIN_PATH=5744b9c9b3821d00e16f7210  ->  /5744b9c9b3821d00e16f7210/partners
# This HIDES the panel, it does not protect it: the value is in the JS bundle,
# because the browser has to know where to route. The login is the real gate.
VITE_ADMIN_PATH=

# "Continue with Google" (required — there is no demo chooser any more).
# Create an OAuth client ID (type: Web application) in Google Cloud Console →
# APIs & Services → Credentials, and add every address the app is served from to
# "Authorized JavaScript origins", e.g. http://localhost:5173 and
# https://your-site.vercel.app. Without this the sign-in button reports that it
# is not configured.
VITE_GOOGLE_CLIENT_ID=

# Admin panel sign-in — Firebase (Google), invite-only. See docs/ADMIN_ACCESS.md.
# Firebase console → Project settings → General → Your apps → Web app → config.
# These are public identifiers, safe in the browser bundle (the security is in
# firestore.rules and the /api proxy check), but keep them out of chat anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server side (Vercel → Environment Variables): the same project id, read by
# api/proxy.js to verify admin sign-ins. Without it every admin call is refused.
FIREBASE_PROJECT_ID=
# Development only: try the admin screens without Firebase (fake Google prompt).
# Ignored in production builds.
# VITE_ADMIN_AUTH_FAKE=true
