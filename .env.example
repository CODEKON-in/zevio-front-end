# Copy this file to `.env.local` (never commit .env.local).

# Used ONLY by the dev/preview proxy in vite.config.js — never sent to the browser
# (no VITE_ prefix, so Vite does not put them in the app).
ZEVIO_API_URL=https://zevio-apis.vercel.app
ZEVIO_API_KEY=zv_9bdd622418c41160f169273c2d619853af50237773dedeab

# "Continue with Google" (required — there is no demo chooser any more).
# Create an OAuth client ID (type: Web application) in Google Cloud Console →
# APIs & Services → Credentials, and add every address the app is served from to
# "Authorized JavaScript origins", e.g. http://localhost:5173 and
# https://your-site.vercel.app. Without this the sign-in button reports that it
# is not configured.
VITE_GOOGLE_CLIENT_ID=238941476634-p3kk1h8bgaosgkku7rm3omun16o83qt5.apps.googleusercontent.com

