{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "build": {
    "env": {
      "VITE_DATA_SOURCE": "api",
      "VITE_GOOGLE_CLIENT_ID": "238941476634-p3kk1h8bgaosgkku7rm3omun16o83qt5.apps.googleusercontent.com"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
