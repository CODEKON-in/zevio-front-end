rules_version = '2';

// Mynt — Firestore security rules.
//
// adminUsers/{email}: the admin allowlist (document id = lowercased email).
//   - a signed-in user may read their OWN entry (that is how sign-in checks it);
//   - an active superadmin may read and write all entries;
//   - an active admin may update their own lastLoginAt and nothing else;
//   - a superadmin can never remove, deactivate or demote themself.
//
// shops / products / orders: superadmin everything; a shop owner only
// documents whose shopId (or, for shops, the document id) is their shopId.
// NOTE: today Mynt's shops, products and orders live in Supabase behind the
// Flask API, not in Firestore, so these three blocks only take effect if that
// data is ever moved here. The live data is protected by the same rules in
// the site's /api proxy (api/_adminGuard.js).
//
// Identity: request.auth.token.email (lowercased) with email_verified == true.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function myPath() { return /databases/$(database)/documents/adminUsers/$(myEmail()); }
    function me() { return get(myPath()).data; }
    function isActiveAdmin() { return signedIn() && exists(myPath()) && me().active == true; }
    function isSuperadmin() { return isActiveAdmin() && me().role == 'superadmin'; }
    function isOwnerOf(shopId) {
      return isActiveAdmin() && me().role == 'shop_owner' && shopId is string && me().shopId == shopId;
    }

    // A well-formed allowlist entry for document id `id`.
    function validEntry(id, d) {
      return d.keys().hasOnly(['email', 'role', 'shopId', 'active', 'invitedBy', 'createdAt', 'lastLoginAt'])
        && d.email == id && id == id.lower()
        && d.active is bool
        && (
          (d.role == 'superadmin' && !d.keys().hasAny(['shopId']))
          || (d.role == 'shop_owner' && d.shopId is string && d.shopId.size() > 0)
        );
    }

    match /adminUsers/{id} {
      allow read: if signedIn() && (id == myEmail() || isSuperadmin());

      allow create: if isSuperadmin() && validEntry(id, request.resource.data);

      // A superadmin may edit anyone — but their own entry must stay an active superadmin.
      allow update: if isSuperadmin()
          && validEntry(id, request.resource.data)
          && (id != myEmail() || (request.resource.data.role == 'superadmin' && request.resource.data.active == true));

      // Anyone allowed in may stamp their own last login, and touch nothing else.
      allow update: if isActiveAdmin() && id == myEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']);

      allow delete: if isSuperadmin() && id != myEmail();
    }

    match /shops/{shopId} {
      allow read, update: if isSuperadmin() || isOwnerOf(shopId);
      allow create, delete: if isSuperadmin();
    }

    match /products/{productId} {
      allow read, delete: if isSuperadmin() || isOwnerOf(resource.data.shopId);
      allow create: if isSuperadmin() || isOwnerOf(request.resource.data.shopId);
      allow update: if isSuperadmin()
          || (isOwnerOf(resource.data.shopId) && request.resource.data.shopId == resource.data.shopId);
    }

    match /orders/{orderId} {
      allow read: if isSuperadmin() || isOwnerOf(resource.data.shopId);
      allow update: if isSuperadmin()
          || (isOwnerOf(resource.data.shopId) && request.resource.data.shopId == resource.data.shopId);
      allow create, delete: if isSuperadmin();
    }

    // Everything else: closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
